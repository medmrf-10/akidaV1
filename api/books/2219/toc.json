{"id": 2219, "slug": "الفقه-الأبسط", "title": "الفقه الأبسط", "author": "أبو حنيفة", "death": "150", "toc": [{"i": 0, "t": "﷽", "d": 0, "pg": 1}, {"i": 1, "t": "من أصول أهل السنة والجماعة", "d": 0, "pg": 1}, {"i": 2, "t": "أفضل الفقه وتعريف الإيمان وأركانه", "d": 0, "pg": 4}, {"i": 3, "t": "حكم من كذب بالخلق او انكر معلوما من الدين بالضرورة", "d": 0, "pg": 11}, {"i": 4, "t": "كلامه عن الاستطاعة", "d": 0, "pg": 15}, {"i": 5, "t": "الرد على من زعم ان الله لم يخلق الشر", "d": 0, "pg": 16}, {"i": 6, "t": "القول فيمن يشك في إيمانه", "d": 0, "pg": 24}, {"i": 7, "t": "المؤمن قد يعذب بذنوبه", "d": 0, "pg": 27}, {"i": 8, "t": "الكفار يؤمنون عند المعاينة", "d": 0, "pg": 29}, {"i": 9, "t": "أثر معاذ", "d": 0, "pg": 32}, {"i": 10, "t": "وجوب الهجرة الى الله", "d": 0, "pg": 35}, {"i": 11, "t": "إثبات العلو", "d": 0, "pg": 36}, {"i": 12, "t": "اثبات عذاب القبر", "d": 0, "pg": 37}, {"i": 13, "t": "تحريم التألي على الله", "d": 0, "pg": 38}, {"i": 14, "t": "وجوب لزوم القرآن", "d": 0, "pg": 40}, {"i": 15, "t": "الاستثناء في الإيمان", "d": 0, "pg": 48}]}